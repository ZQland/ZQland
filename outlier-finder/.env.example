# Copy to .env and fill in what you have. Anything missing runs on demo data.

# YouTube Data API v3 key (free): console.cloud.google.com → enable "YouTube Data API v3" → Credentials
YOUTUBE_API_KEY=

# Apify token for the TikTok + Instagram scrapers (paid per result): console.apify.com → Settings → Integrations
APIFY_TOKEN=

# Instagram official API (only if platforms.instagram is "official" in niches.yaml)
IG_ACCESS_TOKEN=
IG_USER_ID=

# Claude, for script/format breakdowns: console.anthropic.com → API keys
ANTHROPIC_API_KEY=
